# OPC Agents .gitignore

# 运行时状态（不提交）
scripts/state.json
scripts/state.json.bak
scripts/state.json.lock
scripts/state.json.bak.tmp
# 知识库（独立仓库，不提交）
project-context.md
# Playwright MCP 日志（不提交）
.playwright-mcp/
# OpenCode 自动生成（不提交）
.opencode/.gitignore
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
# 归档的技能（不提交，太大）
skills-archive/

# 社区技能（运行时安装，不提交）
.opencode/skills/*/
# OPC 专属技能（要提交）
!.opencode/skills/daily-check/
!.opencode/skills/meeting-minutes/
!.opencode/skills/knowledge-search/
!.opencode/skills/skill-index/
!.opencode/skills/lessons-index/
# 长任务产出（运行时产物，不提交）
.opencode/work/*
!.opencode/work/.gitkeep

# 环境变量文件（含真实密钥，不提交）
.env
.env.local
.env.production
# 系统文件
*.log
*.swp
*~
.DS_Store
.reasonix/
.codegraph/
.deveco/
reasonix.toml

# Node.js（仅用于 OpenCode 插件开发，不提交）
node_modules/
package-lock.json
*.tgz
package.json
# pnpm 误建（仓库使用 npm，pnpm-lock/pnpm-workspace 非有意引入，不提交）
pnpm-lock.yaml
pnpm-workspace.yaml
# Python 缓存（不提交）
scripts/__pycache__/
.herdr-finding.md
# 系统产出物不入库（公众号文章/配图等本地工作成果）
output/
