# OPC Agents 环境变量
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# 以下两个 key 被 opencode.json 的 provider 使用（必填，从 https://token.sensenova.cn 获取）：
# jensen003 provider（baseURL https://token.sensenova.cn/v1）
JENSEN003_API_KEY=your_api_key_here
# souljian03 provider（baseURL https://token.sensenova.cn/v1）
SOULJIAN03_API_KEY=your_api_key_here

# 历史遗留占位（无 provider 引用，保留仅作说明）
SENSENOVA_API_KEY=your_api_key_here

# 必填：运行时产出路径
OPC_WORK_PATH=~/code/opc/opc-agents/work

# 必填：知识库路径
OPC_KNOWLEDGE_PATH=~/code/opc/opc-knowledge
